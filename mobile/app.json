{
  "expo": {
    "name": "Arise",
    "slug": "arise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nezeville.arise",
      "appleTeamId": "W6V9R9C5KX",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Arise uses alarms to wake you up at the time you choose."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111F45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nuuchsystems.arise",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.1"
          }
        }
      ],
      "./plugins/withoutPushEntitlement",
      "./plugins/withReleaseSigning"
    ],
    "scheme": "arise"
  }
}
